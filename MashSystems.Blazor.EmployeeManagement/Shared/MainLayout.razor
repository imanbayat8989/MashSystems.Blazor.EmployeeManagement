@inherits LayoutComponentBase

<PageTitle>سامانه مدیریت پرسنل</PageTitle>

<div class="page" dir="rtl">
    <div class="sidebar">
        <NavMenu />
    </div>

    <AuthorizeView>
        <Authorized>
            <main>
                <article class="content px-4 py-3">
                    @Body
                </article>
            </main>
        </Authorized>
        <NotAuthorized>
            <RedirectToLogin />
        </NotAuthorized>
    </AuthorizeView>
</div>